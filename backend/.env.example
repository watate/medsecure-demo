# GitHub PAT — fine-grained with Code scanning (R&W), Contents (R&W), Pull requests (R&W)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Default baseline branch (usually "main") — used when a tracked repo has no default_branch
BRANCH_BASELINE=main

# Devin API
DEVIN_API_KEY=
DEVIN_ORG_ID=
PARENT_PLAYBOOK_ID=
CHILD_PLAYBOOK_ID=

# Anthropic API (claude-opus-4-6)
ANTHROPIC_API_KEY=

# OpenAI API (gpt-5.3-codex)
OPENAI_API_KEY=

# Google Gemini API (gemini-3.1-pro-preview)
GEMINI_API_KEY=

# Remediation batching — max file groups per batch (default: 10)
BATCH_SIZE=10

# Database (use /data/medsecure.db for Docker with volume mount)
DATABASE_PATH=medsecure.db

# S3 backup
S3_BACKUP_BUCKET=
AWS_REGION=us-east-1

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=http://localhost:3000
